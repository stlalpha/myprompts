// Signal Mine / vaporwave fastfetch config.
// Ported from the neofetch config of the same name; neofetch was archived
// upstream in 2024 and dropped by every package manager this project targets.
//
// Palette: neon pink 198, cyan 51, purple 141, orange 209, mint 85,
// magenta 201 -- the same 256-colour indices the neofetch layout used.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/signalmine.txt",
    "color": {
      "1": "38;5;44",
      "2": "38;5;24"
    },
    "padding": {
      "right": 3
    }
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    "break",
    {
      "type": "title",
      "key": "◆ User",
      "keyColor": "38;5;198"
    },
    {
      "type": "os",
      "key": "◆ OS",
      "keyColor": "38;5;51"
    },
    {
      "type": "host",
      "key": "◆ Host",
      "keyColor": "38;5;141"
    },
    {
      "type": "kernel",
      "key": "◆ Kernel",
      "keyColor": "38;5;209"
    },
    {
      "type": "uptime",
      "key": "◆ Uptime",
      "keyColor": "38;5;85"
    },
    {
      "type": "shell",
      "key": "◆ Shell",
      "keyColor": "38;5;201"
    },

    "break",
    {
      "type": "custom",
      "format": "\u001b[38;5;198m【\u001b[38;5;51mH A R D W A R E\u001b[38;5;198m】\u001b[0m"
    },
    "break",
    {
      "type": "cpu",
      "key": "◆ CPU",
      "keyColor": "38;5;51"
    },
    {
      "type": "gpu",
      "key": "◆ GPU",
      "keyColor": "38;5;141"
    },
    {
      "type": "memory",
      "key": "◆ Memory",
      "keyColor": "38;5;209"
    },
    {
      "type": "disk",
      "key": "◆ Disk",
      "keyColor": "38;5;85"
    },
    {
      "type": "display",
      "key": "◆ Display",
      "keyColor": "38;5;201"
    },

    "break",
    {
      "type": "custom",
      "format": "\u001b[38;5;198m【\u001b[38;5;85mN E T W O R K\u001b[38;5;198m】\u001b[0m"
    },
    "break",
    {
      "type": "localip",
      "key": "◆ Local IP",
      "keyColor": "38;5;51"
    },
    {
      "type": "publicip",
      "key": "◆ Public IP",
      "keyColor": "38;5;141"
    },
    "break"
  ]
}
