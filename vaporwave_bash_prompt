#!/usr/bin/env bash
# Signal Mine / vaporwave Bash prompt.
# Requires bash 3.2+ (the macOS system bash). No bash-4-only syntax.
#
#   MYPROMPTS_THEME         signalmine (default) | vaporwave
#   MYPROMPTS_PROMPT_STYLE  compact (default) | extended
#   MYPROMPTS_GIT           set to 0 to disable the git segment
#   MYPROMPTS_DURATION_MIN  seconds; commands at least this long show a duration (default 5)

[ -n "${BASH_VERSION:-}" ] || return 0

myprompts_self=${BASH_SOURCE[0]}
myprompts_root=$(cd "$(dirname "$myprompts_self")" && pwd)
if [ -f "$myprompts_root/lib/prompt_common.sh" ]; then
    # shellcheck source=/dev/null
    # Path is resolved at runtime from myprompts_root -- shellcheck cannot
    # follow it statically.
    . "$myprompts_root/lib/prompt_common.sh"
else
    return 0
fi
mp_load_theme

# Wrap raw escapes in \[ \] so readline does not count them toward line width.
mp_c() { printf '\[%s\]' "$(mp_fg "$1")"; }
mp_r() { printf '\[%s\]' "$(mp_reset)"; }
mp_b() { printf '\[%s\]' "$(mp_bold)"; }

# Colors are fixed at source time; only content varies per draw.
# Each MP_ACCENT*/MP_OK/MP_INFO/MP_ERR/MP_MUTED role variable below is set by
# the sourced theme file (themes/*.sh via mp_load_theme), which shellcheck
# cannot follow statically, so it reads as a possible misspelling of the
# MP_C_* variable being assigned. Disabled per-line rather than file-wide.
# shellcheck disable=SC2153
MP_C_ACCENT1=$(mp_c "$MP_ACCENT1")
# shellcheck disable=SC2153
MP_C_ACCENT2=$(mp_c "$MP_ACCENT2")
# shellcheck disable=SC2153
MP_C_ACCENT3=$(mp_c "$MP_ACCENT3")
MP_C_OK=$(mp_c "$MP_OK")
# shellcheck disable=SC2153
MP_C_INFO=$(mp_c "$MP_INFO")
# shellcheck disable=SC2153
MP_C_ERR=$(mp_c "$MP_ERR")
# shellcheck disable=SC2153
MP_C_MUTED=$(mp_c "$MP_MUTED")
MP_C_RESET=$(mp_r)
MP_C_BOLD=$(mp_b)

# Lowercase via tr, not the bash-4-only case-modification expansion: macOS ships bash 3.2.
myprompts_style="${MYPROMPTS_PROMPT_STYLE:-compact}"
myprompts_style=$(printf '%s' "$myprompts_style" | tr '[:upper:]' '[:lower:]')

# Writes into the caller-named variable ($1) instead of stdout so the caller
# can assemble "pre" with no command substitution (no subprocess fork).
myprompts_ssh_segment() {
    local outvar=$1
    if [ -n "${SSH_CONNECTION:-}" ] || [ -n "${SSH_TTY:-}" ]; then
        printf -v "$outvar" '%sssh%s ' "$MP_C_INFO" "$MP_C_RESET"
    fi
}

# Takes an optional euid as the second argument so it is testable without
# being root. Writes into the caller-named variable ($1); see above.
myprompts_root_segment() {
    local outvar=$1
    local euid=${2:-$EUID}
    if [ "$euid" -eq 0 ]; then
        printf -v "$outvar" '%s%s#%s ' "$MP_C_ERR" "$MP_C_BOLD" "$MP_C_RESET"
    fi
}

# `jobs %%` is a builtin returning 0 iff a job exists. No subprocess.
# \j is passed as an argument, not in the format string: printf's handling of
# unknown backslash escapes in a format is undefined. PS1 expands it later.
# Writes into the caller-named variable ($1); see above.
myprompts_jobs_segment() {
    local outvar=$1
    if jobs %% >/dev/null 2>&1; then
        printf -v "$outvar" '%s⚙%s%s ' "$MP_C_MUTED" '\j' "$MP_C_RESET"
    fi
}

myprompts_timer_start() {
    if [ -z "${myprompts_timer:-}" ]; then
        myprompts_timer=$SECONDS
    fi
}

myprompts_build_ps1() {
    local exit_code=$?     # MUST be the first statement. Do not move.

    local elapsed=0
    if [ -n "${myprompts_timer:-}" ]; then
        ((elapsed = SECONDS - myprompts_timer))
    fi
    unset myprompts_timer

    local status_seg=""
    if [ "$exit_code" -ne 0 ]; then
        status_seg="${MP_C_ERR}✗${exit_code}${MP_C_RESET} "
    fi

    local dur_seg=""
    if [ "$elapsed" -ge "${MYPROMPTS_DURATION_MIN:-5}" ]; then
        dur_seg="${MP_C_MUTED}${elapsed}s${MP_C_RESET} "
    fi

    local git_seg
    git_seg=$(mp_git_segment)
    if [ -n "$git_seg" ]; then
        git_seg="${MP_C_ACCENT3}${git_seg}${MP_C_RESET} "
    fi

    local root_seg=""
    myprompts_root_segment root_seg
    local ssh_seg=""
    myprompts_ssh_segment ssh_seg
    local jobs_seg=""
    myprompts_jobs_segment jobs_seg

    local pre
    pre="${root_seg}${ssh_seg}${status_seg}${dur_seg}${jobs_seg}"

    if [ "$myprompts_style" = "extended" ]; then
        PS1="${pre}${MP_C_ACCENT1}\u${MP_C_INFO}@${MP_C_ACCENT2}\h${MP_C_RESET} "
        PS1="${PS1}${MP_C_OK}\w${MP_C_RESET} ${git_seg}"
        PS1="${PS1}"$'\n'"${MP_C_ACCENT1}╰─${MP_C_INFO}▸${MP_C_RESET} "
    else
        PS1="${pre}${MP_C_ACCENT1}◤${MP_C_ACCENT2}\u${MP_C_INFO}@${MP_C_ACCENT2}\h${MP_C_ACCENT1}◢${MP_C_RESET} "
        PS1="${PS1}${MP_C_ACCENT1}【${MP_C_OK}\w${MP_C_ACCENT1}】${MP_C_RESET} "
        PS1="${PS1}${git_seg}${MP_C_INFO}${MP_C_BOLD}▸${MP_C_RESET} "
    fi
}

# Chain onto any pre-existing DEBUG trap instead of clobbering it.
#
# `trap -p DEBUG` prints a valid shell command (`trap -- 'BODY' DEBUG`), so
# the previous body must never be recovered by string-trimming that output:
# an empty body (the common `trap '' DEBUG` idiom for disabling tracing)
# leaves a bare "; myprompts_timer_start", which bash rejects as a syntax
# error before every command; a body containing a single quote defeats the
# strip entirely, silently leaving the old trap in place with our timer
# never installed. Instead, shadow the `trap` builtin with a function and let
# bash's own parser hand us the body as $2.
#
# Deliberately NOT reset to empty on every source: re-sourcing must not
# forget a body captured on the first source (see the dispatch-already
# installed case below).
myprompts_prev_debug_cmd=${myprompts_prev_debug_cmd:-}

myprompts_capture_debug_trap() {
    local spec
    spec=$(trap -p DEBUG)
    [ -n "$spec" ] || return 0
    case "$spec" in
        *myprompts_debug_dispatch*)
            # Our dispatcher is already installed (idempotent re-source).
            # Leave myprompts_prev_debug_cmd untouched -- recapturing here
            # would set it to "myprompts_debug_dispatch" itself, and the
            # dispatcher would recurse into itself forever.
            return 0
            ;;
    esac
    # shellcheck disable=SC2329  # invoked indirectly, via the eval below
    trap() { myprompts_prev_debug_cmd=$2; }
    eval "$spec" || true
    unset -f trap
}
myprompts_capture_debug_trap
unset -f myprompts_capture_debug_trap

myprompts_debug_dispatch() {
    if [ -n "${myprompts_prev_debug_cmd:-}" ]; then
        eval "$myprompts_prev_debug_cmd"
    fi
    myprompts_timer_start
}

trap myprompts_debug_dispatch DEBUG

case ";${PROMPT_COMMAND:-};" in
    *";myprompts_build_ps1;"*) ;;
    *) PROMPT_COMMAND="myprompts_build_ps1${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
esac

myprompts_build_ps1
export PS1
